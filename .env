VITE_APP_TITLE=Npora Admin

# 同源 API 前缀
VITE_API_PREFIX=/api
# session、local 或 memory
VITE_TOKEN_STORAGE=session
# 完整模板默认显示展示工作台
VITE_DEMO_ENABLED=true
# 控制验证器入口，后端独立校验
VITE_AUTHENTICATOR_ENABLED=true
VITE_PASSWORD_RESET_CONTACT=

# 界面语言策略
VITE_I18N_ENABLED=true
VITE_I18N_DEFAULT_LOCALE=zh-CN
VITE_I18N_FALLBACK_LOCALE=zh-CN
VITE_I18N_DETECT_BROWSER_LANGUAGE=false

# 生产构建输出 gzip 预压缩文件和可选体积清单
VITE_BUILD_COMPRESS=true
VITE_BUILD_ANALYZE=false
