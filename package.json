{
  "name": "admin-template-react",
  "description": "A clean React admin dashboard starter built with TypeScript and Ant Design.",
  "keywords": [
    "react-admin-template",
    "react",
    "typescript",
    "antd",
    "admin-dashboard",
    "vite"
  ],
  "private": true,
  "version": "1.0.26",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:all": "npm run lint && npm run build && npm test",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@npora/request": "^1.23.4",
    "antd": "^6.7.2",
    "dayjs": "^1.11.23",
    "i18next": "^27.2.7",
    "i18next-browser-languagedetector": "^8.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router": "^8.5.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.90.0",
    "sass": "^1.108.2",
    "typescript": "~7.0.2",
    "vite": "^8.4.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
